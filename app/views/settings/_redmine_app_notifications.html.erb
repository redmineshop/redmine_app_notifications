<%# Standard Redmine tabular settings (label left, control right). %>
<p><em class="info"><%= l('redmine_app_notifications.settings.events_info') %></em></p>

<fieldset class="box tabular">
  <legend><%= l('redmine_app_notifications.settings.events') %></legend>

  <% RedmineAppNotifications::Settings::EVENT_KEYS.each do |key| %>
    <p>
      <%= label_tag "settings_#{key}", l("redmine_app_notifications.settings.#{key}") %>
      <%= hidden_field_tag "settings[#{key}]", '0', id: "settings_#{key}_off" %>
      <%= check_box_tag "settings[#{key}]", '1',
                        RedmineAppNotifications::Settings.checked?(@settings, key),
                        id: "settings_#{key}" %>
    </p>
  <% end %>
</fieldset>

<fieldset class="box tabular">
  <legend><%= l('redmine_app_notifications.settings.email') %></legend>
  <p>
    <%= label_tag 'settings_enable_email_fallback',
                  l('redmine_app_notifications.settings.enable_email_fallback') %>
    <%= hidden_field_tag 'settings[enable_email_fallback]', '0',
                         id: 'settings_enable_email_fallback_off' %>
    <%= check_box_tag 'settings[enable_email_fallback]', '1',
                      RedmineAppNotifications::Settings.checked?(@settings, 'enable_email_fallback'),
                      id: 'settings_enable_email_fallback' %>
    <em class="info"><%= l('redmine_app_notifications.settings.enable_email_fallback_info') %></em>
  </p>
  <p>
    <label></label>
    <em class="info"><%= l('redmine_app_notifications.settings.enable_email_fallback_advanced') %></em>
  </p>
</fieldset>
